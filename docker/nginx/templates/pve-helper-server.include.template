# The body shared by the HTTP and HTTPS listeners.
#
# Rendered by the stock envsubst entrypoint step into /etc/nginx/conf.d, but named
# `.include` rather than `.conf` on purpose: conf.d/*.conf is loaded at http level,
# and these are location blocks that only mean anything inside a server. The two
# listeners must not drift, and the only reliable way to guarantee that is for there
# to be one copy.

client_max_body_size ${NGINX_CLIENT_MAX_BODY_SIZE};

proxy_buffering off;
proxy_request_buffering off;
proxy_max_temp_file_size 0;
proxy_read_timeout ${NGINX_PROXY_READ_TIMEOUT};
proxy_send_timeout ${NGINX_PROXY_SEND_TIMEOUT};
send_timeout ${NGINX_SEND_TIMEOUT};

access_log /dev/stdout pve_helper_download if=$pve_helper_is_download;

# Where nginx sends a plain HTTP request that arrived on the TLS listener. Reached
# only through `error_page 497`, which the listener include wires up when HTTPS is
# on, so this is inert the rest of the time. $http_host rather than $host because it
# carries the port the caller actually used, and the port does not change here —
# only the scheme does.
location @pve_helper_https_upgrade {
    return 308 https://$http_host$request_uri;
}

location = /healthz/nginx {
    access_log off;
    add_header Content-Type text/plain;
    return 200 "ok\n";
}

location /_pve_helper_download/ {
    internal;
    alias /storages/;
    disable_symlinks on from=/storages;
    add_header X-Accel-Buffering no always;
}

location /console/ws/ {
    proxy_pass http://console:8001;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $pve_helper_connection_upgrade;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto $pve_helper_forwarded_proto;
    proxy_set_header X-Forwarded-Port $server_port;
    proxy_buffering off;
}

location / {
    proxy_pass http://web:8000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto $pve_helper_forwarded_proto;
    proxy_set_header X-Forwarded-Port $server_port;
    proxy_set_header Connection "";
}
